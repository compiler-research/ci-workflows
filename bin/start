#!/usr/bin/env python3
"""Newcomer entry point: pick a project, land in a container ready to work in.

    git clone https://github.com/compiler-research/ci-workflows
    cd ci-workflows && ./bin/start

Prints the projects in projects.yaml with the toolchain each one
develops against, takes a number, clones the project if it isn't on
disk yet, and hands the whole thing to `bin/repro --devshell` -- which
downloads that toolchain from the recipe cache, installs the recipe's
host dependencies, and opens a shell with Claude Code in it.

Any other repository works too, as long as its CI uses ci-workflows:

    ./bin/start --repo yourname/clad          # owner/repo, URL or path
    cd ~/src/my-fork && ~/src/ci-workflows/bin/start

A repository outside the catalog has no recorded cell, so its own
workflows are read instead: every setup-llvm /
setup-recipe call is evaluated against every matrix row (bin/cells.py),
and the cells a dev container can serve are offered, plainest first.

Why a second entry point rather than a `bin/repro` flag: repro's
audience already knows what a matrix row is and why they want to
reproduce one. This one's audience has been handed a link by a
supervisor. Nothing here is new machinery: a devshell is opened by
running a `bin/repro --devshell ...` command line through repro.main
(see devshell_argv), so provisioning, container naming, ccache wiring
and the AI setup all stay in repro, and the CLI a user could type is the
only contract between the two. Which cell a repository's rows pull is
bin/cells.py's business. What this file owns is the catalog, the
prompts, and the choice of cell to hand repro.

Deliberately stdlib-only, like bin/repro: a student running this has
Docker and a Python, and that has to be enough. YAML is read with
bin/gha.py's parser for the same reason.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import re
import shlex
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Dict, List, Optional, Tuple

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "bin"))
import cells  # noqa: E402
import gha  # noqa: E402
PROJECTS_YAML = REPO_ROOT / "projects.yaml"
#: Where a project gets cloned when the user accepts the default.
DEFAULT_SRC_PARENT = Path.home() / "src"
#: Mirrors bin/repro's DEVSHELL_HOST_CACHE_DEFAULT, which is what
#: --devshell-host-cache resolves to and where the cell is unpacked.
DEVSHELL_HOST_CACHE = Path.home() / ".cache" / "ci-workflows" / "devshell-cache"
#: Free space below which we say so. Advisory, not a floor: preflight
#: runs before a project is picked, and cells differ by an order of
#: magnitude -- biodynamo unpacks to ~800 MB, an LLVM cell to ~4 GB --
#: so any single number would either block a small project needlessly
#: or wave a big one through.
WARN_FREE_GIB = 10

_COORD_KEYS = cells.COORD_KEYS
_REQUIRED = ("name", "description", "repo") + _COORD_KEYS


def _load_repro():
    """Import the extensionless bin/repro as a module.

    Same SourceFileLoader dance bin/test_repro.py uses; repro is
    import-safe (everything is behind functions and a main() guard).
    """
    path = REPO_ROOT / "bin" / "repro"
    loader = importlib.machinery.SourceFileLoader("repro", str(path))
    spec = importlib.util.spec_from_loader("repro", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ---------------------------------------------------------------- catalog


def load_projects(path: Optional[Path] = None) -> List[Dict[str, str]]:
    """projects.yaml's `projects:` list, every value a string.

    Entries missing a required field are dropped rather than raised
    on: a malformed row should cost the student that one project, not
    the whole menu. verify.yml is what makes malformed rows loud.
    """
    try:
        doc = gha.load_yaml(path or PROJECTS_YAML)
    except (OSError, gha.YAMLError, IndexError):
        return []
    out: List[Dict[str, str]] = []
    for entry in (doc or {}).get("projects") or []:
        if not isinstance(entry, dict):
            continue
        p = {str(k): gha.to_str(v) for k, v in entry.items()}
        # workflow and row go together: either the entry names the CI
        # row its cell came from, or (a project whose CI does not use
        # ci-workflows) neither.
        if all(p.get(k) for k in _REQUIRED) \
                and bool(p.get("workflow")) == bool(p.get("row")) \
                and clone_options(p) is not None:
            out.append(p)
    return out


#: `git clone` options a catalog entry may ask for: a partial-clone
#: filter to keep a large repository's first clone small, and the branch
#: the entry's cell serves. Nothing that configures git.
_CLONE_OPTION = re.compile(
    r"^--(filter=(blob:none|tree:0)|branch=[A-Za-z0-9][A-Za-z0-9._/-]*)$")


def clone_options(project: Dict[str, str]) -> Optional[List[str]]:
    """The entry's `clone` field as git clone options, or None if any
    of them is not one a catalog entry may set."""
    opts = shlex.split(project.get("clone", ""))
    if all(_CLONE_OPTION.match(o) for o in opts):
        return opts
    return None


def clone_branch(project: Dict[str, str]) -> Optional[str]:
    """The branch the entry clones, if it names one."""
    for o in clone_options(project) or []:
        if o.startswith("--branch="):
            return o[len("--branch="):]
    return None


def coord_of(project: Dict[str, str]) -> Dict[str, str]:
    """The (recipe, version, os, arch) tuple a project develops against."""
    return {k: project[k] for k in _COORD_KEYS}


coord_str = cells.coord_str


# -------------------------------------------------------------- preflight


def _docker_status() -> Tuple[bool, str]:
    """Return (ok, detail) for the docker daemon.

    Client version and daemon reachability are separate failures with
    separate fixes, so they get separate messages: an installed client
    that can't reach a daemon means "start Docker Desktop", a missing
    binary means "install it".
    """
    if shutil.which("docker") is None:
        return False, "not installed -- see https://docs.docker.com/get-docker/"
    try:
        version = subprocess.run(
            ["docker", "version", "--format", "{{.Client.Version}}"],
            capture_output=True, text=True, timeout=30,
        ).stdout.strip()
        info = subprocess.run(
            ["docker", "info", "--format", "{{.ServerVersion}}"],
            capture_output=True, text=True, timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as e:
        return False, f"could not be queried ({e})"
    if info.returncode != 0:
        return False, (f"{version or 'installed'}, but the daemon is not "
                       f"running -- start Docker and try again")
    return True, f"{version or info.stdout.strip()}, daemon up"


def _disk_status() -> Tuple[bool, str]:
    """Free space where the unpacked cell will land.

    Measured at the cache location rather than $PWD, which on a laptop
    is often a different volume. Never blocks: see WARN_FREE_GIB.
    """
    probe = DEVSHELL_HOST_CACHE
    while not probe.exists() and probe != probe.parent:
        probe = probe.parent
    try:
        free_gib = shutil.disk_usage(probe).free / (1024 ** 3)
    except OSError as e:
        return True, f"could not be determined ({e})"
    detail = f"{free_gib:.0f} GB free at {probe}"
    if free_gib < WARN_FREE_GIB:
        detail += " -- tight for the larger cells"
    return True, detail


def _host_machine() -> str:
    """The machine's architecture, not the interpreter's.

    platform.machine() reports the *process* arch, so an x86_64 Python
    under Rosetta calls an Apple Silicon Mac "x86_64" -- and then we
    would fail to warn about exactly the machine that needs the
    warning. sysctl.proc_translated is macOS's answer to "am I being
    translated"; it is absent on a native process.
    """
    import platform as _platform
    machine = _platform.machine().lower()
    if _platform.system().lower() != "darwin" or machine != "x86_64":
        return machine
    try:
        out = subprocess.run(["sysctl", "-n", "sysctl.proc_translated"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return machine
    return "arm64" if out.stdout.strip() == "1" else machine


def _platform_status() -> Tuple[bool, str]:
    """Note x86_64-on-arm64 translation rather than failing on it.

    A translated container is fine for developing and wrong for
    timing, so this is information the user needs and not a reason to
    stop.
    """
    import platform as _platform
    system = _platform.system().lower()
    machine = _host_machine()
    if machine in ("arm64", "aarch64"):
        return True, (f"{system}/{machine} -- x86_64 containers run "
                      f"translated (fine to develop in, not to time)")
    return True, f"{system}/{machine}"


def preflight() -> bool:
    """Print the environment checks; return False if any blocks."""
    checks = [
        ("docker", _docker_status()),
        ("disk", _disk_status()),
        ("platform", _platform_status()),
    ]
    print("  checking prerequisites")
    ok = True
    for label, (passed, detail) in checks:
        prefix = "    " if passed else "  ! "
        print(f"{prefix}{label:<18}{detail}")
        ok = ok and passed
    print()
    return ok


# ------------------------------------------------------------ cell status


def _asset_size(base: str, key: str) -> Optional[int]:
    """Content-Length of the cell's install asset, or None.

    A HEAD rather than cache_io.cache_probe(), which throws the size
    away -- the download size is the single most useful number to show
    someone about to wait for it. Kept here rather than added to
    cache_io for the reason in the module docstring: that directory
    feeds the cache key.
    """
    asset = f"{key}.tar.zst"
    if base.startswith("file://"):
        p = Path(base[len("file://"):]) / asset
        return p.stat().st_size if p.is_file() else None
    if not base.startswith(("http://", "https://")):
        return None
    req = urllib.request.Request(f"{base.rstrip('/')}/{asset}", method="HEAD")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            if not 200 <= resp.status < 400:
                return None
            length = resp.headers.get("Content-Length")
            return int(length) if length else None
    except (urllib.error.HTTPError, urllib.error.URLError,
            ValueError, OSError):
        return None


def cell_status(repro, base: str, project: Dict[str, str],
                catalog: List[Dict[str, str]]) -> str:
    """One line describing whether this project's cell is usable.

    Two failures are worth distinguishing. Not in cells.yaml means the
    catalog is stale and no amount of waiting helps. In cells.yaml but
    not on the backend means the cell simply hasn't been warmed yet,
    which fixes itself on the next publish.
    """
    coord = coord_of(project)
    if not cells.in_catalog(coord, catalog):
        return "unknown cell -- not in cells.yaml, this entry is stale"
    try:
        key = repro._devshell_compute_key(coord)
    except (subprocess.CalledProcessError, SystemExit):
        return "cell key could not be computed"
    size = _asset_size(base, key)
    if size is None:
        return "not published yet -- pick another, or warm this cell first"
    return f"published -- {size / (1024 ** 2):.0f} MB download"


# ------------------------------------------------------------------ menu


def render(projects: List[Dict[str, str]], statuses: List[str]) -> None:
    print("  ci-workflows projects")
    print()
    for i, (p, status) in enumerate(zip(projects, statuses), start=1):
        coord = coord_of(p)
        print(f"  {i:>2}  {p['name']:<14} {p['description']}")
        print(f"      {'':<14} {coord['recipe']} {coord['version']} "
              f"- {coord['os']}/{coord['arch']}")
        print(f"      {'':<14} {status}")
        print()


#: select()'s answer for "another repository" on the project menu.
OTHER = -1


def select(count: int, what: str = "a project",
           other: bool = False, default: Optional[int] = None
           ) -> Optional[int]:
    """Prompt until a valid index or a quit. Returns a 0-based index,
    OTHER when `other` is on and the user picked `o`, or None to quit.

    EOF counts as quit so a piped or non-interactive run exits cleanly
    instead of looping on an empty read.
    """
    extra = ", o for another repository" if other else ""
    dflt = f" [{default + 1}]" if default is not None else ""
    while True:
        try:
            raw = input(f"  select {what} [1-{count}]{extra}, "
                        f"or q to quit{dflt}: ")
        except EOFError:
            print()
            return None
        raw = raw.strip().lower()
        if raw in ("q", "quit", "exit"):
            return None
        if not raw and default is not None:
            return default
        if other and raw in ("o", "other"):
            return OTHER
        if raw.isdigit() and 1 <= int(raw) <= count:
            return int(raw) - 1
        print(f"  not a choice: {raw!r}")


def _confirm(prompt: str, default: bool = True) -> bool:
    suffix = "[Y/n]" if default else "[y/N]"
    try:
        raw = input(f"  {prompt} {suffix} ").strip().lower()
    except EOFError:
        print()
        return False
    if not raw:
        return default
    return raw in ("y", "yes")


# -------------------------------------------------------------- checkout


def resolve_checkout(project: Dict[str, str]) -> Optional[Path]:
    """Find or create the project's checkout; return its path.

    An existing directory is reused as-is and never touched -- it is
    the user's working copy, and this tool has no business pulling or
    resetting it.
    """
    default = DEFAULT_SRC_PARENT / project["name"]
    print()
    print(f"  {project['name']}")
    print(f"    clone to    {default}            [enter to accept]")
    if "recipe" in project:
        print(f"    toolchain   {project['recipe']} {project['version']}")
    else:
        print("    toolchain   read from its workflows after cloning")
    print()
    try:
        raw = input(f"  path [{default}]: ").strip()
    except EOFError:
        print()
        return None
    dest = Path(raw).expanduser().resolve() if raw else default

    if dest.is_dir():
        if not (dest / ".git").is_dir():
            print(f"  {dest} exists but is not a git checkout; "
                  f"pick another path.")
            return None
        print(f"  using the checkout already at {dest}")
        return dest

    opts = " ".join(clone_options(project) or [])
    if not _confirm(f"clone {project['repo']}{' (' + opts + ')' if opts else ''}"
                    f" to {dest}?"):
        return None
    dest.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["git", "clone", *(clone_options(project) or []),
                        "--", project["repo"], str(dest)])
    if r.returncode != 0:
        print(f"  git clone failed (exit {r.returncode})")
        return None
    return dest


def _repo_slug(url: str) -> str:
    """owner/repo out of a clone URL, for comparing catalog to remote."""
    trimmed = url.rstrip("/")
    if trimmed.endswith(".git"):
        trimmed = trimmed[:-len(".git")]
    parts = trimmed.replace(":", "/").split("/")
    return "/".join(parts[-2:]).lower() if len(parts) >= 2 else trimmed.lower()


def detect_project(repro, projects: List[Dict[str, str]]
                   ) -> Optional[Tuple[Dict[str, str], Path]]:
    """If the cwd is a checkout of a catalogued project, return it.

    Two entry paths, one command. Someone starting from nothing runs
    this from the ci-workflows clone and picks off the menu; someone
    already sitting in their checkout should not be asked which
    project they are in, nor where to put it. Matching is on the
    origin remote rather than the directory name, so a fork or a
    renamed directory still resolves.

    An entry that clones a branch (llvm-23 clones release/23.x) matches
    only a checkout on that branch: its cell serves that branch, and a
    checkout of main or of another release would otherwise be put on it
    without being asked.
    """
    slug = repro._origin_repo_slug()
    if not slug:
        return None
    top = None
    for p in projects:
        if _repo_slug(p["repo"]) != slug.lower():
            continue
        if top is None:
            top = _git_out("rev-parse", "--show-toplevel")
            if not top:
                return None
        branch = clone_branch(p)
        if branch and _git_out("-C", top, "rev-parse", "--abbrev-ref",
                               "HEAD") != branch:
            continue
        return p, Path(top)
    return None


def _git_out(*args: str) -> Optional[str]:
    """`git *args` output, stripped, or None when it fails."""
    try:
        r = subprocess.run(["git", *args], capture_output=True, text=True,
                           timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def repo_cell(checkout: Path,
              project: Dict[str, str]) -> Optional[Dict[str, str]]:
    """The cell the project's own workflow gives its catalogued row.

    The catalog makes the menu renderable before anything is cloned,
    but the project is the authority on what it builds against, so once
    it is on disk its row is read back with cells.scan -- all four
    coord fields, so a bumped version, a new recipe or a moved os all
    win over a stale projects.yaml entry. None when the row is gone or
    fetches no cell; the catalog's answer then stands.
    """
    if not project.get("row"):
        return None
    for rc in cells.scan(checkout):
        if rc.row == project["row"] and rc.workflow == project["workflow"]:
            return rc.primary
    return None


# ---------------------------------------------------- any other checkout


_git_toplevel = gha.checkout_root


_SLUG_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def custom_checkout(spec: str) -> Optional[Path]:
    """Turn `--repo` (a path, a URL, or owner/repo) into a checkout.

    A path that exists is used as-is, like a catalogued project's
    existing checkout. Anything else is cloned through the same prompt
    the menu uses. owner/repo means GitHub.
    """
    as_path = Path(spec).expanduser()
    if as_path.exists():
        top = _git_toplevel(as_path)
        if top is None:
            print(f"  {as_path} is not inside a git checkout.")
        return top
    url = f"https://github.com/{spec}" if _SLUG_RE.match(spec) else spec
    name = _repo_slug(url).split("/")[-1] or "project"
    return resolve_checkout({"name": name, "repo": url})


def _devshell_servable(repro, coord: Dict[str, str]) -> bool:
    """Can `bin/repro --devshell` open a container for this cell?"""
    try:
        repro._devshell_image(coord["os"])
        repro._devshell_platform(coord["arch"])
    except SystemExit:
        return False
    return True


#: start_checkout()'s answer when the user quit at its prompt.
QUIT = ({}, {})


def repo_cells(repro, checkout: Path, catalog: List[Dict[str, str]]
               ) -> Tuple[List[Tuple[Dict[str, str], List[str]]],
                          List[Tuple[Dict[str, str], List[str], str]]]:
    """Group the checkout's rows by toolchain cell (RowCells.primary)
    into (usable, unusable).

    usable: (coord, rows) a devshell can open, cells.plainest_first.
    unusable: the same plus the reason, so "why is my row missing" has
    an answer.
    """
    grouped: Dict[Tuple[str, ...], List[str]] = {}
    for rc in cells.scan(checkout):
        coord = rc.primary
        if coord is None:
            continue
        rows = grouped.setdefault(tuple(coord[k] for k in _COORD_KEYS), [])
        if rc.row not in rows:
            rows.append(rc.row)
    usable, unusable = [], []
    for key, rows in grouped.items():
        coord = dict(zip(_COORD_KEYS, key))
        if not cells.in_catalog(coord, catalog):
            unusable.append((coord, rows, "not in cells.yaml"))
        elif not _devshell_servable(repro, coord):
            unusable.append((coord, rows, "no dev container for this "
                                          "os/arch"))
        else:
            usable.append((coord, rows))
    usable.sort(key=lambda item: cells.plainest_first(item[0], len(item[1])))
    return usable, unusable


def _rows_str(rows: List[str], limit: int = 3) -> str:
    shown = ", ".join(rows[:limit])
    return shown + (f" +{len(rows) - limit} more" if len(rows) > limit
                    else "")


def render_repo(name: str, checkout: Path, refs: int,
                usable, unusable, statuses: List[str]) -> None:
    print(f"  {name} ({checkout}) uses ci-workflows "
          f"({refs} reference{'s' if refs != 1 else ''} under .github/)")
    print()
    for i, ((coord, rows), status) in enumerate(zip(usable, statuses),
                                                start=1):
        print(f"  {i:>2}  {coord['recipe']} {coord['version']} "
              f"- {coord['os']}/{coord['arch']}")
        print(f"      rows      {_rows_str(rows)}")
        print(f"      {status}")
        print()
    if unusable:
        print("  also in its CI, but not available here:")
        for coord, rows, why in unusable:
            print(f"    {coord_str(coord):<48} {why} "
                  f"({_rows_str(rows, 2)})")
        print()


def start_checkout(repro, base: str, catalog: List[Dict[str, str]],
                   checkout: Path, list_only: bool = False
                   ) -> Optional[Tuple[Dict[str, str], Dict[str, str]]]:
    """Pick a cell for an uncatalogued checkout.

    Returns (project, coord), QUIT if the user quit at the prompt, or
    None when there is nothing to offer.

    Refuses a repository that does not use ci-workflows at all, and one
    whose CI only installs LLVM from apt/brew (setup-llvm's
    flavor=system): neither has a cell to download, so there is nothing
    a dev container could add over the host.
    """
    name = checkout.name
    refs = gha.ci_workflows_refs(checkout)
    if not refs:
        print(f"  {name} ({checkout}) does not use compiler-research/"
              f"ci-workflows: no action or workflow of ours is referenced "
              f"under .github/, so there is no cached toolchain to set "
              f"up.")
        return None
    usable, unusable = repo_cells(repro, checkout, catalog)
    statuses = [cell_status(repro, base, coord, catalog)
                for coord, _rows in usable]
    render_repo(name, checkout, len(refs), usable, unusable, statuses)
    if list_only:
        return None
    if not usable:
        print(f"  none of {name}'s CI rows pull a cell a dev container "
              f"can serve")
        print("  (rows on flavor=system install LLVM from apt/brew). "
              "bin/repro <row> replays one under act instead.")
        return None
    index = 0 if len(usable) == 1 else select(len(usable), "a toolchain",
                                              default=0)
    if index is None:
        return QUIT
    coord = dict(usable[index][0])
    return {"name": name, "repo": str(checkout)}, coord


# ------------------------------------------------------------------ main


def devshell_argv(checkout: Path, coord: Dict[str, str]) -> List[str]:
    """The `bin/repro` command line that opens this checkout's devshell.

    bin/start drives repro through its CLI -- repro.main(argv) -- and
    through nothing else, so any change to repro's internals stays
    compatible with this file for as long as the documented command
    line keeps working. Host-cache mode is on because a newcomer wants
    the download to survive `docker volume rm` and a machine move; the
    cell goes as a direct coord, which skips row lookup and act.
    """
    return ["--devshell", "--devshell-host-cache",
            "--devshell-patches-out", str(checkout), coord_str(coord)]


def launch(repro, project: Dict[str, str], checkout: Path,
           coord: Dict[str, str]) -> int:
    """Hand off to `bin/repro --devshell` (see devshell_argv)."""
    # Say where the work lives before the shell opens, because the
    # question it answers ("how do I get my changes out?") otherwise
    # gets asked after the fact. There is no export step: /patches is
    # the checkout, so git runs on the host, where the credentials
    # are -- and deliberately nowhere near a container running an AI
    # agent. The container has no git identity for the same reason.
    argv = devshell_argv(checkout, coord)
    print()
    print(f"  {checkout} is mounted at /patches inside the container.")
    print("  Edits appear there immediately; commit, push and open "
          "pull requests")
    print("  from the host as usual -- no credentials are copied "
          "into the container.")
    print()
    print("  to reopen it later:")
    print(f"    {REPO_ROOT / 'bin' / 'repro'} {' '.join(argv)}")
    print()
    return repro.main(argv)


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="bin/start",
        description="Pick a ci-workflows project and open a dev container "
                    "for it.",
    )
    parser.add_argument(
        "--list", action="store_true",
        help="print the catalog with cell status and exit (no prompts)",
    )
    parser.add_argument(
        "--repo", metavar="REPO",
        help="use this repository instead of the catalog: a path, a clone "
             "URL, or GitHub owner/repo (e.g. yourname/clad). Its "
             "workflows must use ci-workflows",
    )
    args = parser.parse_args(argv)

    projects = load_projects()
    if not projects:
        print(f"error: no usable entries in {PROJECTS_YAML}", file=sys.stderr)
        return 1

    if args.list and args.repo:
        repro = _load_repro()
        sys.path.insert(0, str(REPO_ROOT / "actions" / "lib"))
        import cache_io  # noqa: E402
        path = Path(args.repo).expanduser()
        checkout = _git_toplevel(path) if path.exists() else None
        if checkout is None:
            print(f"error: --list --repo needs a local checkout; "
                  f"{args.repo} is not one", file=sys.stderr)
            return 1
        print()
        start_checkout(repro, cache_io.resolve_cache_base(),
                       repro.published_cells(), checkout, list_only=True)
        return 0

    if args.list:
        repro = _load_repro()
        sys.path.insert(0, str(REPO_ROOT / "actions" / "lib"))
        import cache_io  # noqa: E402
        base = cache_io.resolve_cache_base()
        catalog = repro.published_cells()
        print()
        render(projects, [cell_status(repro, base, p, catalog)
                          for p in projects])
        return 0

    print()
    if not preflight():
        print("  fix the flagged items above, then run ./bin/start again.")
        return 1

    repro = _load_repro()
    sys.path.insert(0, str(REPO_ROOT / "actions" / "lib"))
    import cache_io  # noqa: E402

    base = cache_io.resolve_cache_base()
    catalog = repro.published_cells()

    if args.repo:
        checkout = custom_checkout(args.repo)
        if checkout is None:
            return 1
        return _launch_checkout(repro, base, catalog, checkout)

    detected = detect_project(repro, projects)
    here = _git_toplevel(Path.cwd())
    if (detected is None and here is not None
            and here != REPO_ROOT.resolve()
            and gha.ci_workflows_refs(here)):
        # Sitting in a checkout of an uncatalogued project that uses
        # us: same rule as a catalogued one -- announce, don't ask.
        print(f"  in {here.name} ({here}), which is not in "
              f"projects.yaml; reading its workflows.")
        print()
        return _launch_checkout(repro, base, catalog, here)
    if detected is not None:
        # Announce, don't ask. cd'ing into the checkout and running this
        # is already the answer to both questions the menu path asks,
        # and nothing here writes to the checkout -- it is bind-mounted,
        # not modified. The line below is the disclosure.
        project, checkout = detected
        print(f"  in a {project['name']} checkout ({checkout});"
              f" skipping the menu.")
        print(f"    {cell_status(repro, base, project, catalog)}")
    else:
        statuses = [cell_status(repro, base, p, catalog) for p in projects]
        render(projects, statuses)
        print("   o  another repository -- any whose CI uses ci-workflows")
        print()
        index = select(len(projects), other=True)
        if index is None:
            return 0
        if index == OTHER:
            try:
                spec = input("  repository (path, URL or owner/repo): "
                             ).strip()
            except EOFError:
                print()
                return 0
            if not spec:
                return 0
            checkout = custom_checkout(spec)
            if checkout is None:
                return 1
            return _launch_checkout(repro, base, catalog, checkout)
        project = projects[index]
        maybe_checkout = resolve_checkout(project)
        if maybe_checkout is None:
            return 1
        checkout = maybe_checkout

    coord = coord_of(project)
    theirs = repo_cell(checkout, project)
    if theirs and theirs != coord:
        print(f"  note: {project['name']}'s {project['row']} row pulls "
              f"{coord_str(theirs)}, projects.yaml records "
              f"{coord_str(coord)}; using the repo's.")
        coord = theirs

    return launch(repro, project, checkout, coord)


def _launch_checkout(repro, base: str, catalog: List[Dict[str, str]],
                     checkout: Path) -> int:
    """--repo / `o` / an uncatalogued cwd: scan, pick a cell, launch."""
    picked = start_checkout(repro, base, catalog, checkout)
    if picked is None:
        return 1
    if picked is QUIT:
        return 0
    project, coord = picked
    return launch(repro, project, checkout, coord)


def cli(argv: Optional[List[str]] = None) -> int:
    """main(), with Ctrl+C at a prompt or mid-download ending the run
    quietly (exit 130) rather than in a traceback."""
    try:
        return main(argv)
    except KeyboardInterrupt:
        print("\n  interrupted.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(cli())
