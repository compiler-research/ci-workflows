#!/usr/bin/env bash
# bin/repro --devshell installs this at /usr/local/bin/devshell-repro-config
# and runs it as root inside the container. Paths come from the env
# (DEVSHELL_SRC, DEVSHELL_BUILD, LLVM_PREFIX); ccache knobs come from
# DEVSHELL_PRODUCER_COMPILER_CHECK + the CCACHE_* vars bin/repro
# reads from the recipe's manifest. Idempotent: tools install once,
# cmake configure no-ops when CMakeCache.txt exists.

set -e

if ! command -v ccache >/dev/null 2>&1; then
  apt-get update -qq
  # Match .github/actions/install-build-deps/action.yml (Linux path)
  # exactly: same compiler (clang) and same set of build deps the
  # publish-recipe pipeline used.
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    cmake ninja-build zstd ccache rsync clang libedit-dev git sudo
fi

# The AI CLI the devshell is built to host. devshell-init calls this
# hook when `claude` isn't already on PATH, and honours an exported
# override in place of its own no-op stub -- so this is what actually
# puts claude in the shell. npm's global prefix inside the act image is
# the node toolcache, which is on PATH for root and dev alike, so one
# root-side install serves the unprivileged shell too.
#
# Never fatal: a devshell with no AI is still a working devshell, and
# repro-config runs under `set -e`.
devshell_install_ai_cli() {
  echo "devshell: installing claude-code..."
  if ! npm install -g @anthropic-ai/claude-code >/dev/null 2>&1; then
    echo "::warning::devshell: claude-code install failed; install it" \
         "by hand in the shell (npm install -g @anthropic-ai/claude-code)"
  fi
}
export -f devshell_install_ai_cli

bash /usr/local/bin/devshell-init

# Detect & install whatever libstdc++-N-dev the producer used. Read
# CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES out of the manifest's
# cmake_state and check for the corresponding /usr/include/c++/N
# locally; apt-install if missing. catthehacker/ubuntu:act-24.04
# ships libstdc++-13-dev, but the GHA-hosted ubuntu-24.04 runner has
# libstdc++-14-dev. Clang picks the highest available libstdc++,
# so a mismatch makes every C++ TU's preprocessor output diverge --
# 100% ccache miss against the producer cache. For pre-cmake_state
# manifests fall back to libstdc++-14-dev as the empirical default.
need_cxx_n=$(python3 - <<'PY' "$DEVSHELL_MANIFEST"
import json, os, re, sys
try:
    m = json.load(open(sys.argv[1]))
except (OSError, json.JSONDecodeError):
    sys.exit(0)
cmf = (m.get("cmake_state") or {}).get("CMakeCXXCompiler.cmake", "")
match = re.search(
    r'CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES\s+"([^"]*)"', cmf
)
if match:
    for p in match.group(1).split(";"):
        m2 = re.match(r"/usr/include/c\+\+/(\d+)$", p)
        if m2 and not os.path.isdir(p):
            print(m2.group(1))
            sys.exit(0)
elif not os.path.isdir("/usr/include/c++/14"):
    print("14")
PY
)
if [[ -n "$need_cxx_n" ]]; then
  echo "::warning::installing libstdc++-${need_cxx_n}-dev (producer used /usr/include/c++/${need_cxx_n} but it's not installed locally)"
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    "libstdc++-${need_cxx_n}-dev"
fi

# Generic dev-package divergence check. Compare the producer's
# installed_packages map (manifest field, post-cmake_state branch)
# against ours; for each *-dev / clang* / cmake / ninja* / ccache the
# producer had with a different version, surface a single warning
# line. No auto-install (versions may not be available in the local
# apt sources, and dev tools rarely matter beyond libstdc++ which the
# block above already handles); the warning lets the dev decide.
python3 - <<'PY' "$DEVSHELL_MANIFEST" || true
import json, os, subprocess, sys
try:
    m = json.load(open(sys.argv[1]))
except (OSError, json.JSONDecodeError):
    sys.exit(0)
producer = (m.get("build_env") or {}).get("installed_packages") or {}
if not producer:
    sys.exit(0)
RELEVANT = ("-dev",)
RELEVANT_PREFIX = ("clang", "cmake", "ninja", "ccache", "lld",
                   "libedit", "libtinfo", "libxml2", "zlib")
candidates = {
    n: v for n, v in producer.items()
    if n.endswith(RELEVANT) or n.startswith(RELEVANT_PREFIX)
}
if not candidates:
    sys.exit(0)
try:
    r = subprocess.run(
        ["dpkg-query", "-W", "-f=${Package}\\t${Version}\\n",
         *candidates.keys()],
        capture_output=True, text=True,
    )
except FileNotFoundError:
    sys.exit(0)
local: dict[str, str] = {}
for line in r.stdout.splitlines():
    if "\t" in line:
        n, v = line.split("\t", 1)
        local[n] = v
diffs = []
for n, v in candidates.items():
    lv = local.get(n)
    if lv is None:
        diffs.append(f"{n}: missing locally (producer={v})")
    elif lv != v:
        diffs.append(f"{n}: producer={v} local={lv}")
if diffs:
    print("::warning::package-version drift vs producer (may cause ccache miss):", file=sys.stderr)
    for d in diffs[:10]:
        print(f"  {d}", file=sys.stderr)
    if len(diffs) > 10:
        print(f"  ... +{len(diffs)-10} more", file=sys.stderr)
PY

# The shell and --devshell-script run as dev, so everything from here on
# that writes into the workspace does too: a build tree or a ccache log
# that root created locks dev out of both.
as_dev() { setpriv --reuid=dev --regid=dev --init-groups "$@"; }

as_dev ccache --max-size=5G
# Mirror publish-recipe's compiler_check. When the manifest records
# the producer's value, apply it verbatim (consumer's $CC --version
# may differ in package metadata even with matching binaries) and
# warn if the version line genuinely diverges.
cc_version=$("$CC" --version | head -1)
if [[ -n "${DEVSHELL_PRODUCER_COMPILER_CHECK:-}" ]]; then
  as_dev ccache --set-config="compiler_check=$DEVSHELL_PRODUCER_COMPILER_CHECK"
  recorded="${DEVSHELL_PRODUCER_COMPILER_CHECK#string:}"
  if [[ "$recorded" != "$cc_version" ]]; then
    echo "warning: compiler version differs from recipe; ccache will miss." >&2
    echo "  recipe: $recorded" >&2
    echo "  here:   $cc_version" >&2
  fi
else
  as_dev ccache --set-config="compiler_check=string:$cc_version"
fi
# ccache refuses precompiled-header compiles (LLVM >= 23 uses them)
# unless sloppiness allows them, on this side as on the producer's.
# The producer's recorded value plus the PCH pair: sloppiness is not in
# the key, so adding to it cannot cost a hit.
sloppiness=$(python3 - "${DEVSHELL_MANIFEST:-}" <<'PY'
import json, sys
try:
    cfg = (json.load(open(sys.argv[1])).get("build_env") or {}).get("ccache") or {}
    have = cfg.get("sloppiness") or ""
except (OSError, ValueError, IndexError):
    have = ""
items = [s for s in have.replace(" ", ",").split(",") if s and s != "unknown"]
for s in ("pch_defines", "time_macros"):
    if s not in items:
        items.append(s)
print(",".join(items))
PY
)
as_dev ccache --set-config="sloppiness=$sloppiness"

build="${DEVSHELL_BUILD:?env not set; bin/repro --devshell exports it}"
src="${DEVSHELL_SRC:?env not set; bin/repro --devshell exports it}"
prefix="${DEVSHELL_INSTALL:-${LLVM_PREFIX:?env not set; bin/repro --devshell exports it}}"
manifest="${DEVSHELL_MANIFEST:?env not set; bin/repro --devshell exports it}"

# Recipes whose host dependencies exceed LLVM's can ship a
# devshell-setup.sh beside their build.py; run it before the configure
# below. build.py installs those packages too, but on the producer,
# which is no help to a dev here: without them the recipe's own source
# will not configure, and neither will a consumer building against the
# artifact.
#
# Not fatal, for the same reason the configure below is not: a package
# that failed to install should cost the dev that package, not the shell.
recipe_name=$(python3 - <<'PY' "$manifest"
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("recipe") or "")
except (OSError, json.JSONDecodeError, IndexError):
    pass
PY
)
hook="/ci-workflows/recipes/${recipe_name}/devshell-setup.sh"
if [[ -n "$recipe_name" && -f "$hook" ]]; then
  echo "devshell: installing ${recipe_name}'s host dependencies..."
  bash "$hook" || echo "::warning title=devshell::${hook} failed;" \
    "the recipe's own source may not configure."
fi

if [[ ! -f "$build/CMakeCache.txt" ]]; then
  as_dev mkdir -p "$build"
  cd "$build"
  # Replay the recipe's own cmake invocation from the manifest's cmake_args
  # field (post-#53), rewriting the two things that are producer-specific: the
  # install prefix and the source path. ccache hashes the full compile command,
  # so any drift here defeats the sibling-cache pre-warm.
  #
  # The source rewrite has to cover both shapes recipes use. LLVM's build.py
  # runs cmake from a build directory and passes the relative `../llvm`, since
  # its CMakeLists lives in an llvm/ subdirectory. Every other recipe passes an
  # absolute `-S <work_dir>/<name>` -- which points at the *producer's*
  # filesystem and does not exist here, so passing it through unchanged
  # configures against nothing.
  exec_cmake_args=$(python3 - <<'PY'
import json, os, shlex, sys
sys.path.insert(0, "/ci-workflows/scripts")
import devshell_cmake

manifest = json.load(open(os.environ["DEVSHELL_MANIFEST"]))
args = manifest.get("cmake_args") or []
if not args:
    sys.exit(0)
out = devshell_cmake.rewrite(
    args,
    prefix=os.environ.get("DEVSHELL_INSTALL") or os.environ["LLVM_PREFIX"],
    src=os.environ["DEVSHELL_SRC"],
    build=os.environ["DEVSHELL_BUILD"],
)
print(" ".join(shlex.quote(x) for x in out))
PY
)
  if [[ -z "$exec_cmake_args" ]]; then
    # Pre-#53 publishes carry no cmake_args. Guessing the flags is only
    # possible for LLVM, and a wrong guess is worse than no configure: it
    # produces a build tree whose compile commands miss the producer's ccache
    # entirely. Leave it to the dev, who can see the manifest.
    echo "::warning title=devshell::manifest has no cmake_args; skipping the" \
         "cmake configure. Configure \$DEVSHELL_BUILD by hand."
  elif ! eval as_dev cmake "$exec_cmake_args"; then
    # Not fatal. This configure is a convenience for devs who intend to
    # rebuild the recipe's own source; the install tree, the ccache and
    # the AI CLI are all in place without it, so failing here would cost
    # the dev the whole shell over an optional step.
    #
    # It fails routinely for recipes with host dependencies beyond
    # LLVM's. build.py apt-installs those itself before configuring, but
    # that runs on the *producer*; the block at the top of this script
    # installs only the LLVM set, so e.g. the biodynamo recipe stops at
    # "We did not find any OpenMPI installation".
    #
    # Drop the half-written cache: cmake writes CMakeCache.txt even when
    # it aborts, and leaving it would make every later session take the
    # skip branch above and never retry the configure.
    rm -rf "$build/CMakeCache.txt" "$build/CMakeFiles"
    echo "::warning title=devshell::the recipe's cmake configure failed;" \
         "the devshell is still usable. To rebuild \$DEVSHELL_SRC, apt-install" \
         "the host packages the recipe's build.py installs, then re-run" \
         "bin/repro --devshell."
  fi
fi

sanity_tu="lib/Support/CMakeFiles/LLVMSupport.dir/Allocator.cpp.o"
have_sanity_tu() {
  [[ -f "$build/build.ninja" ]] \
    && (cd "$build" && ninja -t commands "$sanity_tu" >/dev/null 2>&1)
}

# Locale. ccache hashes LANG, LC_ALL, LC_CTYPE and LC_MESSAGES into every
# key (they localise the diagnostics it caches), so a shell whose locale
# differs from the producer's build misses the entire cache -- which is
# how the llvm-release 22 cell, built under LANG=C.UTF-8, came to give
# this container 0 hits. Runners disagree on it, so find it: replay the
# smoke compile read-only under each candidate, recorded one first, and
# keep the first that the producer's cache answers. The winner goes to
# $BASH_ENV's file, which non-interactive bash sources and
# /etc/bash.bashrc sources for interactive shells.
env_file="${BASH_ENV:-/etc/devshell-env.sh}"
locale_vars=(LANG LC_ALL LC_CTYPE LC_MESSAGES)
write_locale() {  # $1: "VAR=value ..." (may be empty)
  {
    echo "# Written by repro-config: the locale the producer's ccache was keyed with."
    printf 'unset %s\n' "${locale_vars[*]}"
    for kv in $1; do printf 'export %q\n' "$kv"; done
    # Where Claude Code's own installer puts it -- the one route that
    # works without sudo.
    echo 'case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac'
  } > "$env_file"
  chmod 0644 "$env_file"
}
# A hit only says something about the producer if the entry it came from
# is the producer's: this devshell's own earlier compiles (another
# session's, or a probe's under another locale) land in the same cache.
# Entries record their creation time; the producer's predate its
# manifest's built_at.
built_at=$(python3 - "$manifest" <<'PY'
import json, sys
from datetime import datetime, timezone
try:
    t = json.load(open(sys.argv[1])).get("built_at", "")
    print(int(datetime.strptime(t, "%Y-%m-%dT%H:%M:%SZ")
              .replace(tzinfo=timezone.utc).timestamp()))
except (OSError, ValueError, TypeError, json.JSONDecodeError):
    pass
PY
)
producer_hit() {  # $1: ccache log of one probe compile
  grep -qE "Result: (direct|preprocessed)_cache_hit" "$1" || return 1
  [[ -n "$built_at" ]] || return 0
  local key entry created
  key=$(grep -oE "Result key: [0-9a-z]+" "$1" | tail -1 | awk '{print $3}')
  entry="${CCACHE_DIR}/${key:0:1}/${key:1:1}/${key:2}R"
  created=$(as_dev ccache --inspect "$entry" 2>/dev/null \
            | awk '/^Creation time:/ {print $3}')
  [[ -n "$created" && "$created" -le $((built_at + 3600)) ]]
}

# Without a smoke target to probe with (non-LLVM recipes), the record is
# all there is to go on.
chosen="${DEVSHELL_PRODUCER_LOCALE-}"
if have_sanity_tu && ! as_dev ccache --get-config sloppiness | grep -q locale; then
  candidates=()
  [[ -n "${DEVSHELL_PRODUCER_LOCALE+set}" ]] \
    && candidates+=("${DEVSHELL_PRODUCER_LOCALE}")
  for c in "" "LANG=C.UTF-8" "LC_CTYPE=C.UTF-8"; do
    [[ -n "${DEVSHELL_PRODUCER_LOCALE+set}" && "$c" == "$DEVSHELL_PRODUCER_LOCALE" ]] \
      || candidates+=("$c")
  done
  found=0
  for c in "${candidates[@]}"; do
    probe_log=$(as_dev mktemp)
    unset_args=(); for v in "${locale_vars[@]}"; do unset_args+=(-u "$v"); done
    (cd "$build" && rm -f "$sanity_tu" \
      && as_dev env "${unset_args[@]}" $c CCACHE_READONLY=1 \
           CCACHE_LOGFILE="$probe_log" ninja "$sanity_tu" >/dev/null 2>&1) || true
    if producer_hit "$probe_log"; then
      chosen="$c"; found=1; rm -f "$probe_log"; break
    fi
    rm -f "$probe_log"
  done
  if [[ $found == 1 ]]; then
    echo "devshell: producer ccache keyed with locale '${chosen:-<none set>}'; exporting it."
    if [[ -n "${DEVSHELL_PRODUCER_LOCALE+set}" && "$chosen" != "$DEVSHELL_PRODUCER_LOCALE" ]]; then
      echo "::warning title=devshell::manifest records locale '${DEVSHELL_PRODUCER_LOCALE:-<none>}' but the cache answered under '${chosen:-<none set>}'."
    fi
  fi
fi
write_locale "$chosen"
grep -qF "$env_file" /etc/bash.bashrc 2>/dev/null \
  || printf '[ -r %s ] && . %s\n' "$env_file" "$env_file" >> /etc/bash.bashrc

# Package installs. The shell has no sudo by default, so apt-get, apt
# and sudo are shadowed in /usr/local/bin by wrappers that run the real
# tool and, when it fails to change packages, add how a package gets in
# from the host (`bin/repro --devshell-install`) below its own error.
cat > /usr/local/bin/devshell-apt-hint <<'HINT'
#!/bin/bash
# Written by repro-config. $@: the failed apt command's arguments.
pkgs=()
for a in "${@:2}"; do [[ $a == -* ]] || pkgs+=("$a"); done
p="${pkgs[*]:-<package>...}"
{
  echo
  echo "devshell: no root here, so packages are installed from the host:"
  echo "    ${DEVSHELL_REOPEN:-bin/repro --devshell <cell>} --devshell-install $p"
  echo "  or straight into this running container:"
  echo "    docker exec -u 0 ${DEVSHELL_CONTAINER:-<container>} apt-get install -y $p"
  echo "  Python packages need no root: python3 -m venv ~/.venv && ~/.venv/bin/pip install <pkg>"
  echo "  nor does conda: \"\${SHELL}\" <(curl -L micro.mamba.pm/install.sh)"
} >&2
HINT
for tool in apt-get apt; do
  cat > "/usr/local/bin/$tool" <<WRAP
#!/bin/bash
# Written by repro-config: the real $tool, plus a hint when a package
# change fails for want of root.
[[ \$EUID -eq 0 ]] && exec /usr/bin/$tool "\$@"
/usr/bin/$tool "\$@"; rc=\$?
case "\${1:-}" in
  install|reinstall|remove|purge|upgrade|full-upgrade|dist-upgrade|update|autoremove|build-dep)
    [[ \$rc -ne 0 ]] && /usr/local/bin/devshell-apt-hint "\$@" ;;
esac
exit \$rc
WRAP
done
cat > /usr/local/bin/sudo <<'WRAP'
#!/bin/bash
# Written by repro-config: the real sudo; when it fails on apt (no sudo in
# this devshell unless --devshell-sudo), the host command too.
/usr/bin/sudo "$@"; rc=$?
args=("$@"); while [[ ${args[0]:-} == -* ]]; do args=("${args[@]:1}"); done
if [[ $rc -ne 0 && ( ${args[0]:-} == apt || ${args[0]:-} == apt-get ) ]]; then
  /usr/local/bin/devshell-apt-hint "${args[@]:1}"
fi
exit $rc
WRAP
chmod 0755 /usr/local/bin/devshell-apt-hint /usr/local/bin/apt-get \
  /usr/local/bin/apt /usr/local/bin/sudo

# The note an interactive shell opens with. Written here, read at shell
# start, so it reflects the container as it is (Claude installed yet,
# .git read-only or not) rather than as it was at provisioning.
welcome=/etc/devshell-welcome.sh
cat > "$welcome" <<'WELCOME'
# Written by repro-config; sourced by interactive bash (/etc/bash.bashrc).
[[ $- == *i* && -z "${DEVSHELL_WELCOMED:-}" ]] || return 0
export DEVSHELL_WELCOMED=1
_b=$'\e[1m' _d=$'\e[2m' _r=$'\e[0m'
echo
echo "${_b}devshell${_r} ${DEVSHELL_CELL:-} -- ${DEVSHELL_AI_REPO:-your project} is at /patches (you are here)"
echo "  toolchain   ${DEVSHELL_INSTALL:-}"
echo "  recipe src  ${DEVSHELL_SRC:-}   build: ${DEVSHELL_BUILD:-}"
if grep -qE " /patches/\.git [^ ]+ ro[, ]" /proc/mounts 2>/dev/null; then
  echo "  ${_d}.git is read-only here: edit in the container, commit and push on the host${_r}"
fi
echo "  packages    ${_d}no sudo: a failed apt-get install prints the host command; Python: a venv; conda: micromamba${_r}"
if ! command -v claude >/dev/null 2>&1; then
  echo "  Claude Code is not installed. Install it with:"
  echo "    curl -fsSL https://claude.ai/install.sh | bash"
fi
echo
unset _b _d _r
WELCOME
chmod 0644 "$welcome"
grep -qF "$welcome" /etc/bash.bashrc 2>/dev/null \
  || printf '[ -r %s ] && . %s\n' "$welcome" "$welcome" >> /etc/bash.bashrc

# Sanity check: smoke-compile one TU every LLVM build has
# (lib/Support/Allocator.cpp) and verify ccache hits the producer's
# cache. Zero hits => the producer's cache doesn't reach this
# environment (libstdc++ / compile-flag / compiler-version / locale
# drift the earlier checks didn't catch). Surface as ::warning:: rather
# than exiting -- the dev may still want to iterate, just on a cold cache.
#
# Counts only a hit on one of the producer's entries (producer_hit): the
# dev's own earlier compiles of this TU would otherwise pass the check
# for a cache the producer's entries never reach.
if have_sanity_tu; then
  rm -f "$build/$sanity_tu"
  sanity_log=$(as_dev mktemp)
  if (cd "$build" && as_dev env CCACHE_LOGFILE="$sanity_log" \
        bash -c '. "$1"; exec ninja "$2"' _ "$env_file" "$sanity_tu" \
        >/dev/null 2>&1); then
    if producer_hit "$sanity_log"; then
      echo "ccache sanity: Allocator.cpp hit the producer's cache -- it is reaching this consumer."
    elif (cd "$build" && ninja -t commands "$sanity_tu" | grep -q -- -include-pch) \
         && ! python3 -c 'import json,sys; sys.exit("sloppiness" not in (json.load(open(sys.argv[1])).get("build_env") or {}).get("ccache", {}))' "$manifest"; then
      echo "::warning title=ccache sanity::the producer's cache has no entry for ${sanity_tu##*/}: this build uses precompiled headers, and the cell was published before publish-recipe let ccache cache those (sloppiness pch_defines,time_macros), so it holds almost nothing. Republish the cell to get a useful cache; this devshell's own rebuilds are cached either way."
    else
      echo "::warning title=ccache sanity::smoke-compile of ${sanity_tu##*/} missed the producer's cache under every candidate locale; its entries likely won't apply to your builds. Compare 'ccache --show-config' to manifest.build_env.ccache, 'ninja -t commands' to manifest.cmake_args, and the recorded CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES."
    fi
  fi
  rm -f "$sanity_log"
fi

cat <<EOF

DevEnv ready. Common next steps:
  cd \$DEVSHELL_BUILD
  ninja clang clangInterpreter clangStaticAnalyzerCore \\
        LLVMOrcDebugging LLVMLineEditor
  ccache --show-stats
  ninja install-distribution

Source: \$DEVSHELL_SRC  (shallow checkout @ recipe SHA;
                         git fetch --unshallow for history)
EOF
